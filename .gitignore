# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Sitzungsunterlagen niemals einchecken (Testfixtures nur bewusst, anonymisiert/kurz)
*.pdf
!tests/fixtures/**/*.pdf
