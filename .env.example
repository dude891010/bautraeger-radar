# Kopieren nach .env – NIE einchecken.

# LLM-API (wird ab Schritt 3 benötigt)
ANTHROPIC_API_KEY=

# Kontaktadresse, die im User-Agent des Scrapers erscheint (Pflicht für höfliches Scraping).
# Beispiel: it@hummel-kuechen.example
SCRAPER_CONTACT=

# Optional: alternativer Pfad zur Konfiguration
# RADAR_CONFIG=config/settings.yaml

# E-Mail-Benachrichtigung bei neuen Treffern (radar/notifier.py) - optional: fehlt eine der
# folgenden Variablen, bleibt die Benachrichtigung deaktiviert (kein Fehler, kein Lauf-Abbruch).
# Test unabhängig von einem echten Lauf: `python -m radar test-email`.
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Ein oder mehrere Empfänger, durch Komma getrennt, z. B. vertrieb@example.org,it@example.org
NOTIFICATION_RECIPIENT=
